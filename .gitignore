# --- Secrets and environment files ---
# Stores API keys and credentials; committing it can leak paid keys and allow account abuse.
.env
# Captures environment-specific secret files like .env.local/.env.dev that often hold private tokens.
.env.*
# Keep only redacted templates in Git so teammates know required variables without exposing secrets.
!.env.example

# --- Python virtual environments (machine specific) ---
# Local interpreter + installed packages; huge, OS-specific, and fully reproducible from requirements.
venv/
# Common alternate venv folder name; same reason as above.
.venv/
# Another common local environment directory name that should not be versioned.
env/
# Case variant used on some systems; ignored to avoid accidental commits.
ENV/
# Also ignore nested virtual environments (present in subfolders like RAG_LEARNINGS_CLAUDE/venv).
**/venv/
# Nested alternate venv name; prevents duplicated dependencies being committed from subprojects.
**/.venv/

# --- Python bytecode and analysis caches ---
# Python runtime cache generated automatically; changes frequently and is never source of truth.
__pycache__/
# Same cache inside nested packages/subprojects.
**/__pycache__/
# Compiled bytecode files; binary artifacts depend on Python version/platform.
*.py[cod]
# Optimized bytecode output; generated artifact, not hand-written code.
*.pyo
# Windows Python extension binaries; build output, not portable source.
*.pyd
# Test runner cache used for speed only; stale cache can cause noisy diffs and confusion.
.pytest_cache/
# Static type checker cache; deterministic from source and expensive noise in commits.
.mypy_cache/
# Linter cache; local performance artifact with no review value.
.ruff_cache/

# --- Jupyter notebook runtime artifacts ---
# Autosave snapshots generated by Jupyter; duplicate notebook states and clutter diffs.
.ipynb_checkpoints/
README.ipynb
run_readme.ipynb

# --- RAG / vector-store generated data ---
# Generated FAISS index directory; large binary retrieval state rebuilt from source documents.
faiss_index/
# Alternate vector database output folder used by RAG flows; local generated storage.
vector_db/
# FAISS index binaries are machine-generated and typically too large for clean code history.
*.faiss
# Generic ANN/vector index files; derived artifacts rather than authored code.
*.index
# Pickle files may contain large serialized objects and can be unsafe/unreliable across Python versions.
*.pkl
# Downloaded model weights/checkpoints are large external artifacts and should be fetched, not committed.
models/

# --- App runtime uploads/data dumps ---
# User-uploaded documents may contain private content and create non-deterministic repo state.
uploads/
# Local ingestion corpus can be large/private and should be managed outside Git history.
data/

# --- Logs and local diagnostics ---
# Runtime logs change constantly, may contain secrets/PII, and add noise to pull requests.
*.log
# Directory for rolling log output; operational data should not be versioned.
logs/

# --- Build/package artifacts ---
# Packaging/build output generated from source during distribution steps.
build/
# Distribution artifacts (wheels/sdists/bundles) are release outputs, not editable source.
dist/
# Package metadata generated by setuptools/pip during build/install.
*.egg-info/
# Temporary build eggs; reproducible and unnecessary in VCS.
.eggs/

# --- Tooling/editor/OS local files ---
# Personal editor state/extensions/debug settings vary per developer and create unnecessary churn.
.vscode/
# JetBrains project metadata is user/machine specific and usually not portable across teammates.
.idea/
# Vim swap files are transient crash-recovery artifacts.
*.swp
# Alternate Vim swap file pattern; same transient purpose.
*.swo
# Generic editor backup files created during temporary saves.
*~
# macOS Finder metadata file with no project relevance.
.DS_Store
# Windows Explorer thumbnail cache file with no project relevance.
Thumbs.db

# --- Streamlit local configuration ---
# Frequently stores local secrets/config overrides for deployment environments; keep out of Git.
.streamlit/

# --- Repository-local personal scratch space ---
# Contains personal draft docs/resume/latex working files that are not part of application source.
temp/
RAG_LEARNINGS_CLAUDE/


